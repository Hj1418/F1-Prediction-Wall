# NOTE: VITE_* variables are exposed to the client-side bundle in the browser.
# NEVER place private service credentials, private tokens, or database secrets here.
# Only client-safe public configuration belongs in this file.

# Google Apps Script Web App Deployment URL
# Deploy backend/Code.gs + backend/SetupSheet.gs and paste the Exec URL below
VITE_API_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Google OAuth 2.0 Client ID (from Google Cloud Console Credentials > OAuth Client ID)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

